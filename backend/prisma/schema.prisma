generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("EMPLOYEE")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id              String   @id @default(cuid())
  name            String
  description     String?
  longDescription String?
  price           Float
  category        String?
  type            String?
  size            String?
  brand           String?
  stock           Int      @default(0)
  imageUrl        String?
  status          String   @default("APPROVED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PendingApproval {
  id          String   @id @default(cuid())
  actionType  String
  description String
  referenceId String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
