{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "setup": {
          "nixPkgs": ["nodejs_20", "openssl"]
        },
        "install": {
          "cmds": ["npm install --include=dev"]
        },
        "build": {
          "cmds": ["npx prisma generate"]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "sh -c 'npx prisma migrate deploy && node seed.js && node src/server.js'",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
